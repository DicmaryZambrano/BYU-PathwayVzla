generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  text      String
  likes     Int      @default(0)
  likedBy   String[]
  avatar    String
  createdAt DateTime @default(now())
  status    String   @default("pending")
  reviewedAt DateTime?
  reviewedBy String?
}

model Photo {

  id Int @id @default(autoincrement())
  title String
  category String
  uploader String
  imageUrl String
  likes     Int      @default(0)
  likedBy   String[]
  avatar    String
  status String @default("pending")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
}

model Video {
  id Int @id @default(autoincrement())
  title       String
  description String?
  category    String
  uploader    String
  avatar       String
  videoUrl    String
  thumbnailUrl String?
  type        String @default("upload")
  likes       Int @default(0)
  likedBy     String[]
  comments    Int @default(0)
  duration    String?
  status      String @default("pending")
  createdAt   DateTime @default(now())
  reviewedAt   DateTime?
  reviewerName String?
}