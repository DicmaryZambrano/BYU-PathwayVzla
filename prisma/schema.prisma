generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  text      String
  likes     Int      @default(0)
  likedBy   String[]
  avatar    String
  createdAt DateTime @default(now())
  status    String   @default("pending")
  reviewedAt DateTime?
  reviewedBy String?
}